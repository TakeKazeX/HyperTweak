<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <permission
        android:name="com.takekazex.hypertweak.permission.RESTART_SCOPE"
        android:protectionLevel="signature" />
    <!--
      The receivers hooked into other processes register with this as their
      broadcastPermission, which the *sender* must hold. Without this the module could
      not talk to its own receivers and every broadcast was silently dropped.
    -->
    <uses-permission android:name="com.takekazex.hypertweak.permission.RESTART_SCOPE" />

    <queries>
        <package android:name="com.android.systemui" />
        <package android:name="com.android.settings" />
        <!-- Queried by LauncherVersion to read the installed launcher version. -->
        <package android:name="com.miui.home" />
        <package android:name="com.miui.aod" />
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.miui.powerkeeper" />
        <package android:name="com.milink.service" />
        <package android:name="com.xiaomi.scanner" />
        <package android:name="com.xiaomi.bluetooth" />
        <!-- Hosts the hidden Extend Unlock configuration screen. -->
        <package android:name="com.google.android.gms" />
        <!-- Lets the AOSP IME picker enumerate installed input methods. -->
        <intent>
            <action android:name="android.view.InputMethod" />
        </intent>
    </queries>

    <application
        android:name=".HyperTweakApp"
        android:allowBackup="false"
        android:fullBackupOnly="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:description="@string/module_description"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="HyperTweak"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:enableOnBackInvokedCallback="true">
        
        <!-- Xposed Module Configuration -->
        <meta-data
            android:name="xposedmodule"
            android:value="true"/>
        <meta-data
            android:name="xposeddescription"
            android:value="@string/module_description"/>
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope"/>

        <!-- Main Activity -->
        <activity
            android:name="com.takekazex.hypertweak.MainActivity"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|density|layoutDirection|colorMode|fontWeightAdjustment|fontScale"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS"/>
            </intent-filter>
        </activity>

        <!-- Launcher Icon Activity Alias -->
        <activity-alias
            android:name="com.takekazex.hypertweak.MainActivityAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="HyperTweak"
            android:targetActivity="com.takekazex.hypertweak.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <uses-library
            android:name="androidx.window.extensions"
            android:required="false"/>
        <uses-library
            android:name="androidx.window.sidecar"
            android:required="false"/>

        <!-- Receives the privileged battery-info snapshot from com.miui.securitycenter (system uid)
             and serves it back to the module's own page. Exported so the system-uid hooker can call
             it; the SET path is additionally gated to Process.SYSTEM_UID in call(). -->
        <provider
            android:name="com.takekazex.hypertweak.BatteryInfoProvider"
            android:authorities="com.takekazex.hypertweak.batteryprovider"
            android:exported="true"
            android:grantUriPermissions="false" />
    </application>

</manifest>
