<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="package_manager_title">包管理服务</string>
    <string name="package_manager_summary">放宽应用安装与更新检查</string>
    <string name="package_manager_master">启用核心破解</string>
    <string name="package_manager_master_summary">按需选择下方核心破解选项。关闭后，新安装会恢复系统检查，子项设置会保留。</string>
    <string name="package_manager_core_section">核心破解选项</string>
    <string name="package_manager_advanced_section">扩展安装选项</string>
    <string name="package_manager_downgrade">允许应用降级</string>
    <string name="package_manager_downgrade_summary">直接安装旧版本覆盖新版本，无需先卸载。</string>
    <string name="package_manager_update_signature">允许重签名 APK 覆盖安装</string>
    <string name="package_manager_update_signature_summary">用不同签名的 APK 更新同包名应用，原应用数据会保留。</string>
    <string name="package_manager_auth_creak">禁用软件包管理器签名验证</string>
    <string name="package_manager_auth_creak_summary">可安装被修改的 APK、仅有 v1 签名的 APK，或资源表被压缩的 APK。</string>
    <string name="package_manager_disable_integrity">禁用系统完整性校验</string>
    <string name="package_manager_disable_integrity_summary">禁止系统自动恢复被篡改的内容。</string>
    <string name="package_manager_split_signature">允许拆分包签名不同</string>
    <string name="package_manager_split_signature_summary">主 APK 和拆分 APK 签名不同也能一起安装。</string>
    <string name="package_manager_shared_uid">放宽共享 UID 的签名检查</string>
    <string name="package_manager_shared_uid_summary">极度危险：允许不同签名的应用加入同一个普通应用共享 UID，可能共享权限并访问彼此的私有数据，导致数据泄露或应用异常。关闭后不会撤销已建立的共享关系。系统 UID 需另行开启下方选项。</string>
    <string name="package_manager_system_shared_uid">允许系统共享 UID</string>
    <string name="package_manager_system_shared_uid_summary">极度危险：进一步放行系统 UID 与特权共享组的签名检查，允许此类应用的异签名覆盖安装。</string>
    <string name="package_manager_system_shared_uid_confirm_title">允许系统共享 UID？</string>
    <string name="package_manager_system_shared_uid_confirm_message">极度危险！开启后，不同签名的应用可能加入 android.uid.system 等系统或特权共享组，并覆盖更新此类应用（如 miui.systemui.plugin）。\n\n这可能让不可信代码获得系统级权限、访问敏感数据，造成系统界面崩溃或设备无法正常启动。\n\n关闭开关不会撤销已安装的应用或共享关系，也不会自动恢复原版。仅在理解风险且已有恢复手段时开启。能否正常运行仍取决于 APK 与系统版本是否兼容。</string>
    <string name="package_manager_system_shared_uid_confirm">确认开启</string>
    <string name="package_manager_low_target">允许安装面向旧版 Android 的应用</string>
    <string name="package_manager_low_target_summary">安装系统因 targetSdk 过旧而阻止的应用。</string>
    <string name="package_manager_verifier">跳过安装时的系统校验服务</string>
    <string name="package_manager_verifier_summary">不再调用系统的安装校验服务。</string>
    <string name="package_manager_persistent">允许更新系统常驻应用</string>
    <string name="package_manager_persistent_summary">更新系统标记为常驻的应用。</string>
    <string name="package_manager_system_update">允许更新被小米限制的系统应用</string>
    <string name="package_manager_system_update_summary">跳过 HyperOS 对部分预装应用更新的限制。</string>
    <string name="package_manager_isolation">放宽 HyperOS 安装来源和机型限制</string>
    <string name="package_manager_isolation_summary">跳过 HyperOS 基于安装来源或机型规则的检查。</string>
</resources>
