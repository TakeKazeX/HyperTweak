<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="tweaks_three_islands_title">三島調度（實驗性）</string>
    <string name="tweaks_three_islands_summary">橫直向最多顯示三個島，沿用原生任務優先級與手勢；空間不足時恢復雙島。修改後即時生效。</string>
    <string name="tweaks_landscape_full_islands_title">橫向全寬島</string>
    <string name="tweaks_landscape_full_islands_summary">橫向空間充足時，各島顯示完整內容，雙島時也生效。不依賴三島調度開關，空間不足時恢復原生配置。修改後即時生效。</string>
    <string name="tweaks_landscape_more_islands_title">橫向顯示更多超級島</string>
    <string name="tweaks_landscape_more_islands_summary">按橫向可用寬度顯示更多原生超級島，放不下的任務繼續排隊；可搭配全寬或小島配置。修改後即時生效。</string>
    <string name="tweaks_island_live_update_icon_title">修復即時通知圖示</string>
    <string name="tweaks_island_live_update_icon_summary">為即時通知的深色單色圖示補上前景色，改善 ChatGPT 遠端工作階段等圖示不可見的問題。修改立即生效。</string>
    <string name="tweaks_remove_island_placeholder_title">移除超級島結構空位</string>
    <string name="tweaks_remove_island_placeholder_summary">移除左右內容區為對稱平衡而額外撐出的空白，按實際內容收緊；關閉後保留平衡寬度。獨立於三島調度，修改後即時生效。</string>
</resources>
